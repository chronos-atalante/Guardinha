{
  "name": "guardinha",
  "productName": "Guardinha",
  "version": "1.0.1",
  "description": "Cofre de credenciais 100% offline para Linux Mint 22.X (Zena)",
  "main": "out/main/index.js",
  "desktopName": "guardinha.desktop",
  "type": "module",
  "keywords": [
    "cofre",
    "senhas",
    "credenciais",
    "offline",
    "linux-mint"
  ],
  "author": "Otaku Delirante",
  "homepage": "https://github.com/chronos-atalante/guardinha",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "GUARDINHA_VAULT_DIR=\"$PWD/.dev-vault\" electron-vite dev",
    "clean": "rm -rf out release",
    "build": "npm run clean && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tests/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run security:audit && npm run lint:shell",
    "security:audit": "bin/osv-scanner scan source --lockfile package-lock.json --config .osv-scanner.toml .",
    "lint:shell": "bin/shellcheck build/scripts/after-install.sh build/scripts/after-remove.sh build/scripts/guardinha-setup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dist": "npm run build && electron-builder --linux deb",
    "dist:dir": "npm run build && electron-builder --linux deb --dir",
    "postinstall": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "fs-extra": "^11.3.0",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.5.0",
    "electron-vite": "^6.0.0-beta.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "overrides": {
    "@electron/get": "^5.1.0",
    "@electron/asar": "4.3.1",
    "temp": {
      "rimraf": "^6.1.3"
    }
  },
  "build": {
    "appId": "com.guardinha.keypass",
    "productName": "Guardinha",
    "artifactName": "guardinha_${version}_${arch}.${ext}",
    "icon": "build/icon.png",
    "afterPack": "./build/after-pack.cjs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "build/icon.png",
      "THIRD-PARTY-NOTICES.txt",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/scripts/guardinha-setup",
        "to": "guardinha-setup"
      }
    ],
    "asar": true,
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Utility",
      "executableName": "guardinha",
      "syncDesktopName": true,
      "maintainer": "Chronos Atalante <chronos.biblioteca@proton.me>",
      "synopsis": "Cofre de credenciais offline com criptografia AES-256-GCM"
    },
    "deb": {
      "priority": "optional",
      "afterInstall": "build/scripts/after-install.sh",
      "afterRemove": "build/scripts/after-remove.sh",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1"
      ]
    }
  }
}
